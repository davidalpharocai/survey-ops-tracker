# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

.vercel

# downloaded company data
scripts/*.xlsx
scripts/project-id-mapping.csv

# generated data exports. Anchored to the repo root: the unanchored `exports/`
# also matched app/api/exports/, so the export audit route was never committed,
# never deployed, and every CSV pull from 2026-08-25 on went unlogged.
/exports/

# Analysis scratch. Every _-prefixed script under scripts/ is a throwaway probe
# written to answer one question — 340 of them accumulated in a single week of
# cost analysis. They are not part of the build and they made `git status`
# unreadable, which is how a real modified file gets missed in the noise.
scripts/_*

# PureSpectrum import state (scripts/ps-import.mjs) — a local run marker, not data.
scripts/.ps-import-state.json
